# env.demo — ShipSafe Demo: simulates a .env file with weak/exposed credentials
# This file intentionally uses PLACEHOLDER values to demonstrate what ShipSafe detects.
# In the live demo, ShipSafe flags hardcoded secrets in SOURCE FILES (index.js, users.js)
# — not from this file. Rename to .env to trigger the committed-env-file finding.

JWT_SECRET=REPLACE_WITH_REAL_SECRET_IN_ENV
DB_PASSWORD=REPLACE_WITH_REAL_PASSWORD_IN_ENV
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_REAL_KEY
AWS_ACCESS_KEY_ID=REPLACE_WITH_REAL_AWS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_REAL_AWS_SECRET
